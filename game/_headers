# WordBar — Cloudflare Pages / Workers static-asset headers
# The JS/data filenames are not content-hashed, so browsers and the
# service worker must revalidate them on each new visit/deploy.

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Service-Worker-Allowed: /

/index.html
  Cache-Control: no-cache, max-age=0, must-revalidate

/manifest.json
  Cache-Control: no-cache, max-age=0, must-revalidate

/*.js
  Cache-Control: public, max-age=0, must-revalidate

# Masked word banks. Served as opaque bytes: the extension is not in
# Cloudflare's MIME table, so pin the type rather than let it guess.
# nosniff (set globally below) then stops any browser re-interpreting it.
/data/*.wbdata
  Cache-Control: public, max-age=0, must-revalidate
  Content-Type: application/octet-stream
  X-Robots-Tag: noindex, nofollow

/data/manifest.json
  Cache-Control: public, max-age=0, must-revalidate
  Content-Type: application/json; charset=utf-8
  X-Robots-Tag: noindex, nofollow

# Everyday content URLs include the immutable content version. A future bank
# is written under a new directory and activated only after runtime checks.
/data/everyday/*/*.wbdata
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/octet-stream
  X-Robots-Tag: noindex, nofollow

/data/everyday/*/manifest.json
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/json; charset=utf-8
  X-Robots-Tag: noindex, nofollow

/icon-*.png
  Cache-Control: public, max-age=31536000, immutable

/audio/*.mp3
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-WordBar-Build: 86l-phase13-petpop12-faq4-analytics8-batchS12d
